# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES (.env)
# ==============================================================================

# API Base URL (Point to your production backend URL or local dev server)
# In development: http://localhost:5000/api
# In production: https://api.yourdomain.com/api or https://your-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Optional: Stripe Publishable Key (for client-side Stripe Elements / Checkout)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51...
