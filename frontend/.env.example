# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES (.env)
# ==============================================================================

# API Base URL (Point to your production backend URL or local dev server)
# In development: http://localhost:5000/api
# In production: https://mainstays-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Google OAuth Client ID (for Google Sign-In button)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Stripe Publishable Key (Optional)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51...
