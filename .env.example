# ==============================================================================
# ROOT FULL-STACK / DOCKER ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# Database Connection (MongoDB Atlas in production, Local in development)
MONGO_URI=mongodb://localhost:27017/ecommerce

# Redis In-Memory Cache (Upstash Redis in production, Local in development)
REDIS_URL=redis://localhost:6379

# JWT Authentication Secrets (Generate secure random 32-64 char strings)
JWT_SECRET=c8f8b89e378129fbb1c47a9829ef2419842bcda91024
JWT_REFRESH_SECRET=7a912e54bb201f98bc439a012de194829bcdef01948
JWT_EXPIRES_IN=1d

# Frontend & CORS Origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
VITE_API_URL=http://localhost:5000/api

# ------------------------------------------------------------------------------
# PAYMENT GATEWAYS (SSLCommerz & Stripe)
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER=sslcommerz

# SSLCommerz Configuration (Bangladesh & Global payments)
SSLCOMMERZ_STORE_ID=your_sslcommerz_store_id
SSLCOMMERZ_STORE_PASSWORD=your_sslcommerz_store_password
SSLCOMMERZ_IS_SANDBOX=true

# Stripe Configuration (Optional / International Credit Cards)
PAYMENT_SECRET_KEY=sk_test_51...
PAYMENT_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51...

# ------------------------------------------------------------------------------
# TRANSACTIONAL EMAIL (Resend or Generic SMTP)
# ------------------------------------------------------------------------------
# Resend API Key (Just paste your Resend key)
RESEND_API_KEY=re_123456789...

# Or SMTP Settings
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM="MAINSTAYS Atelier" <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# GOOGLE OAUTH & SOCIAL LOGIN
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# CLOUD MEDIA / CDN (Cloudinary / AWS S3)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
