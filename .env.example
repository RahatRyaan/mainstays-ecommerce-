# ==============================================================================
# ROOT DOCKER-COMPOSE / FULL-STACK ENVIRONMENT VARIABLES
# ==============================================================================

NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://mongo:27017/ecommerce
REDIS_URL=redis://redis:6379
JWT_SECRET=supersecretjwtkey_replace_in_production_min_32_chars
JWT_REFRESH_SECRET=supersecretrefreshkey_replace_in_production_min_32_chars
JWT_EXPIRES_IN=1d

# Frontend & CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
VITE_API_URL=http://localhost:5000/api

# Payment Gateway
PAYMENT_PROVIDER=stripe
PAYMENT_SECRET_KEY=sk_test_
PAYMENT_WEBHOOK_SECRET=whsec_

# Email & SMTP Verification Service (supports SendGrid, Mailgun, AWS SES, Gmail, or auto Ethereal)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MAINSTAYS Atelier" <no-reply@mainstays.shop>

# Cloudinary / Image Hosting
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
