# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES (.env)
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# Database Connection (MongoDB Atlas connection string in production)
# Local: mongodb://localhost:27017/ecommerce
# Production Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ecommerce?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/ecommerce

# Redis In-Memory Cache (Upstash Redis or self-hosted Redis)
# Local: redis://localhost:6379
# Production: rediss://default:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379

# JWT Authentication Secrets (Generate secure random 64+ char strings for production)
JWT_SECRET=supersecretjwtkey_replace_in_production_min_32_chars
JWT_REFRESH_SECRET=supersecretrefreshkey_replace_in_production_min_32_chars
JWT_EXPIRES_IN=1d

# Allowed Frontend Origin(s) for CORS (Comma-separated or specific origin)
# In development: http://localhost:5173,http://localhost:3000
# In production: https://mainstays.shop,https://www.mainstays.shop,https://admin.mainstays.shop
CORS_ORIGIN=http://localhost:5173

# Payment Gateway (Stripe or Mock)
PAYMENT_PROVIDER=stripe
PAYMENT_SECRET_KEY=sk_test_51...
PAYMENT_WEBHOOK_SECRET=whsec_...

# Email & SMTP Delivery Service (SendGrid, Mailgun, AWS SES, Resend, or Ethereal Sandbox)
# If left blank, the backend auto-generates Ethereal test accounts with live preview URLs in console!
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_or_smtp_api_key_here
SMTP_FROM="MAINSTAYS Atelier" <no-reply@mainstays.shop>

# Cloud File Storage / CDN (For vendor & product image uploads - Cloudinary or AWS S3)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
